{
  "manifest_version": 3,
  "name": "VIE-Translate",
  "version": "0.4.0",
  "description": "Context-aware Vietnamese subtitle translator powered by Groq & Google Gemini",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VIE-Translate - Cài đặt",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}

