{
  "manifest_version": 3,
  "name": "VIE-Translate — Translate Toad AI",
  "version": "0.6.2",
  "description": "Real-time customizable bilingual subtitle translator, synced music lyrics finder & AI audio captioner for all video websites",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://aistudio.google.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VIE-Translate (Translate Toad AI)",
    "default_popup": "options.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/translate-toad.png",
        "assets/icon48.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["overlay.css"]
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["aistudio-page-hook.js"]
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "run_at": "document_idle",
      "js": ["aistudio-helper.js"]
    }
  ]
}
