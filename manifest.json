{
  "manifest_version": 3,
  "name": "VIE-Translate",
  "version": "0.2.1",
  "description": "Context-aware Vietnamese subtitle translator",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "action": {
    "default_title": "VIE-Translate - Cài đặt & Nhập API Key",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
