{
  "manifest_version": 3,
  "name": "VIE-Translate — Translate Toad AI",
  "version": "1.0.0",
  "description": "All-in-One AI Translator v1.0: Bilingual video subtitles, full-page web translator, manga OCR, contextual dictionary, flashcards & Local/Cloud AI",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "https://translate.googleapis.com/*",
    "https://aistudio.google.com/*",
    "https://lrclib.net/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "VIE-Translate (Translate Toad AI)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "popup/popup.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/translate-toad.png",
        "assets/icon48.png",
        "test/test_bench.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "utils/storage.js",
        "content/dom.js",
        "content/selection.js",
        "content/captions.js",
        "content/manga.js",
        "content/webpage.js",
        "content/content.js"
      ],
      "css": ["content/overlay.css"]
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["content/youtube-hook.js"]
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["aistudio-page-hook.js"]
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "run_at": "document_idle",
      "js": ["aistudio-helper.js"]
    }
  ]
}
